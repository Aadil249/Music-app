<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0E0E14"
    android:orientation="vertical">

    <!-- TOP STATUS STRIP -->
    <TextView
        android:id="@+id/txtNowPlayingBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF161622"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:text="YouTube Music Direct • Ready"
        android:textColor="#DDFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- CONTENT AREA -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: DIRECT YOUTUBE MUSIC -->
        <FrameLayout
            android:id="@+id/panelYtm"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/webViewHost"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- TAB 2: HI-FI 32-BIT DSP -->
        <ScrollView
            android:id="@+id/panelDsp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_setup_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Studio Hi-Fi DSP Engine"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtActivePreset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Harman Hi-Fi"
                            android:textColor="#FFA78BFA"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDspMaster"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <!-- PRESETS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Audiophile Presets"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPreset0"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Harman"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPreset1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="TWS Pro"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPreset2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Sub-Bass"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPreset3"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vocal"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPreset4"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="3D Hall"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPreset5"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Flat"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- MASTERING STAGES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_setup_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sub-Bass Punch"
                        android:textColor="#DDFFFFFF"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seekMainSubBass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="3D Soundstage Width"
                        android:textColor="#DDFFFFFF"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/seekMainStage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Vibe FX Speed"
                        android:textColor="#DDFFFFFF"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMainSlowed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Slowed 0.85x"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnMainNormal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="1.0x"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnMainNightcore"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="Nightcore"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 10-BAND PARAMETRIC EQ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="10-Band Precision EQ (-10 dB to +10 dB)"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/eqSlidersContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_setup_card"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: LOCK SCREEN & OVERLAY STUDIO -->
        <ScrollView
            android:id="@+id/panelLock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_setup_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Aesthetic Lock Screen Widget"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchLockScreen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Shows the full-featured glass player over your lock screen while playing — includes Themes, Clock styles, EQ, Vibe FX, AOD mode, and Sleep Timer."
                        android:textColor="#99FFFFFF"
                        android:textSize="12.5sp" />

                    <Button
                        android:id="@+id/btnPreviewLockScreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Open Lock Screen Widget Now" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_setup_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Seamless Ad Skip &amp; Clean Filter"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAdSkip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Filters ad requests and automatically skips ad slots for uninterrupted playback."
                        android:textColor="#99FFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_setup_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Floating Overlay &amp; Background Permissions"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnOverlayToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Launch Floating Widget" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnGrantOverlayPerm"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Overlay Perm"
                            android:textColor="#DDFFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnBatteryOpt"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Battery / App Info"
                            android:textColor="#DDFFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tip for MIUI / HyperOS: Set Battery Saver to 'No restrictions' and enable 'Show on Lock screen' in App Info -> Other permissions."
                        android:textColor="#77FFFFFF"
                        android:textSize="11.5sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF14141E"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button
            android:id="@+id/navYtm"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="YouTube Music"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navDsp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Hi-Fi DSP"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/navLock"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Lock &amp; Overlay"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
